{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunDocument",
  "description": "driverFOAM Run document v3. Version 3 is the canonical agent-authored planning contract with an open, plugin-schema-validated config object; version 1 and 2 documents must be migrated explicitly before emission.",
  "type": "object",
  "required": ["version", "id", "name", "status", "config"],
  "properties": {
    "version": {"const": "3"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "lastModified": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["draft", "queued", "planning", "planned", "running", "completed", "failed"]
    },
    "intent": {
      "type": "object",
      "description": "Agent- or user-authored objective, constraints, and notes for this run.",
      "additionalProperties": true
    },
    "plugin": {
      "type": ["object", "null"],
      "description": "Solver-plugin semantics selected while the run document was planned.",
      "required": ["id", "version", "api_version", "source", "capability_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "api_version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
        ,"capability_digest": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "Plugin-defined configuration. Core imposes no required keys or shape; a plugin declares and validates its own config schema via get_run_document_config_schema().",
      "additionalProperties": true
    },
    "resolvedEntry": {
      "type": ["object", "null"],
      "properties": {
        "entry": {"type": "string"},
        "entryKind": {"type": ["string", "null"]},
        "entryPath": {"type": ["string", "null"]},
        "resolvedName": {"type": ["string", "null"]},
        "sourceType": {"type": ["string", "null"]},
        "workflowFamily": {"type": ["string", "null"]},
        "isRunnable": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "workflowDag": {
      "type": ["object", "null"],
      "description": "Descriptive workflow DAG. Execution/checkpointing is handled by a later milestone.",
      "required": ["schema_version", "step_status_values", "steps"],
      "properties": {
        "schema_version": {"const": "1"},
        "step_status_values": {
          "type": "array",
          "items": {
            "enum": ["pending", "running", "completed", "failed", "skipped"]
          },
          "minItems": 5
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "command",
              "args",
              "cwd",
              "depends_on",
              "produces",
              "consumes",
              "retry_policy",
              "command_display"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Executable name only; arguments live in args."
              },
              "args": {
                "type": "array",
                "items": {"type": "string"}
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "description": "Case-relative working directory for the step."
              },
              "depends_on": {
                "type": "array",
                "items": {"type": "string"}
              },
              "produces": {
                "type": "array",
                "items": {"type": "string"}
              },
              "consumes": {
                "type": "array",
                "items": {"type": "string"}
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1
              },
              "retry_policy": {
                "type": "object",
                "properties": {
                  "max_attempts": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": true
              },
              "command_display": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "workflowState": {
      "type": ["object", "null"],
      "description": "Initial or runtime step-state snapshot derived from workflowDag.",
      "required": ["status", "current_step_id", "completed_steps", "failed_step_id", "steps"],
      "properties": {
        "status": {"$ref": "#/$defs/workflowStepStatus"},
        "current_step_id": {"type": ["string", "null"]},
        "completed_steps": {
          "type": "array",
          "items": {"type": "string"}
        },
        "failed_step_id": {"type": ["string", "null"]},
        "workflow_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "resume_snapshot": {
          "$ref": "#/$defs/provenanceSnapshot"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step_id",
              "status",
              "attempt",
              "command",
              "args",
              "cwd",
              "started_at",
              "finished_at",
              "exit_code",
              "stdout_log",
              "stderr_log",
              "produced_artifacts",
              "diagnostics"
            ],
            "properties": {
              "step_id": {"type": "string", "minLength": 1},
              "status": {"$ref": "#/$defs/workflowStepStatus"},
              "attempt": {"type": "integer", "minimum": 0},
              "command": {"type": "string", "minLength": 1},
              "args": {
                "type": "array",
                "items": {"type": "string"}
              },
              "cwd": {"type": "string", "minLength": 1},
              "started_at": {"type": ["string", "null"], "format": "date-time"},
              "finished_at": {"type": ["string", "null"], "format": "date-time"},
              "exit_code": {"type": ["integer", "null"]},
              "stdout_log": {"type": ["string", "null"]},
              "stderr_log": {"type": ["string", "null"]},
              "produced_artifacts": {
                "type": "array",
                "items": {"type": "string"}
              },
              "diagnostics": {
                "type": "array",
                "items": {"$ref": "#/$defs/diagnostic"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "launch": {
      "type": ["object", "null"],
      "properties": {
        "action": {"type": "string"},
        "command": {
          "type": "array",
          "items": {"type": "string"}
        },
        "commandDisplay": {"type": "string"},
        "workflowStatePath": {"type": ["string", "null"]},
        "caseRoot": {"type": ["string", "null"]},
        "setupRoot": {"type": ["string", "null"]},
        "outputDir": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "expectedArtifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataArtifact"}
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ok", "failed", "not_run"]},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      },
      "additionalProperties": true
    },
    "results": {"type": ["object", "null"]},
    "reports": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "url", "status"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "url": {"type": "string"},
              "status": {"enum": ["ready", "generating", "failed"]},
              "generatedAt": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        },
        "generatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "terminalStatusValues": {
      "type": "array",
      "items": {"type": "string"},
      "default": ["completed", "failed"]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "workflowStepStatus": {
      "enum": ["pending", "running", "completed", "failed", "skipped"]
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenanceComponent": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "role",
        "origin",
        "method",
        "strength",
        "digest",
        "size",
        "mtime_ns",
        "link_target"
      ],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "origin": {"type": ["string", "null"]},
        "method": {"enum": ["sha256", "metadata", "verified_absence", "unavailable"]},
        "strength": {"enum": ["content", "metadata", "absence", "unavailable"]},
        "digest": {
          "anyOf": [
            {"$ref": "#/$defs/sha256Digest"},
            {"type": "null"}
          ]
        },
        "size": {"type": ["integer", "null"], "minimum": 0},
        "mtime_ns": {"type": ["integer", "null"], "minimum": 0},
        "link_target": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenanceSnapshot": {
      "type": "object",
      "description": "Resume evidence emitted by the current provenance hashing policy.",
      "required": [
        "schema_version",
        "components",
        "workflow_digest",
        "plugin_identity",
        "aggregate_digest",
        "is_complete"
      ],
      "properties": {
        "schema_version": {"const": "2.3-sha256-streaming-256mib-verified-absence"},
        "components": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenanceComponent"}
        },
        "workflow_digest": {"$ref": "#/$defs/sha256Digest"},
        "plugin_identity": {
          "type": "object",
          "required": [
            "id",
            "version",
            "api_version",
            "source",
            "capability_digest",
            "environment_digest"
          ],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "api_version": {"type": "string", "minLength": 1},
            "source": {"type": "string", "minLength": 1},
            "capability_digest": {"$ref": "#/$defs/sha256Digest"},
            "environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "aggregate_digest": {"$ref": "#/$defs/sha256Digest"},
        "is_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["level", "message"],
      "properties": {
        "level": {"enum": ["error", "warning", "info"]},
        "code": {"type": "string"},
        "field": {"type": "string"},
        "message": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "dataArtifact": {
      "type": "object",
      "required": ["artifact_id", "path_pattern", "format"],
      "properties": {
        "artifact_id": {"type": "string"},
        "path_pattern": {"type": "string"},
        "format": {"type": "string"},
        "variables": {
          "type": "array",
          "items": {"type": "string"}
        },
        "description": {"type": "string"},
        "produced_by": {"type": "string"},
        "optional": {"type": "boolean"},
        "time_indexed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
